{
  "name": "hono-middleware",
  "version": "0.0.0",
  "description": "Third-party middleware for Hono",
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "publish": "pnpm publish:npm && pnpm publish:jsr",
    "publish:npm": "pnpm -r publish --no-git-checks && changeset git-tag",
    "publish:jsr": "deno install --no-lock && deno publish",
    "version": "pnpm version:npm && pnpm version:jsr",
    "version:npm": "changeset version",
    "version:jsr": "vp run -r version:jsr",
    "version:set": "node scripts/version-set.ts",
    "typecheck": "tsc --build",
    "typecheck:clean": "tsc --build --clean",
    "typecheck:watch": "tsc --build --watch",
    "test": "vp test",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check .",
    "format:fix": "vp fmt ."
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honojs/middleware.git"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^4.20250612.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typia/unplugin": "^12.1.1",
    "@vitest/coverage-istanbul": "catalog:",
    "hono": "^4.11.5",
    "pkg-pr-new": "^0.0.78",
    "publint": "^0.3.16",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typia": "^12.1.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.9.0"
}
